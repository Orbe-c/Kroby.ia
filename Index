<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Kroby.IA</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --beige-50:#fdf8f0;
  --beige-100:#f5ead6;
  --beige-200:#e8d5b0;
  --beige-300:#d4b483;
  --beige-400:#b8925a;
  --brown-dark:#2c1a0e;
  --brown-mid:#4a2c0a;
  --brown-soft:#8a6040;
  --brown-muted:#a08060;
  --red:#c0392b;
  --red-dark:#96281b;
  --red-light:#e74c3c;
  --green:#27ae60;
  --green-dark:#1e8449;
  --green-light:#2ecc71;
  --font-main:'Sora',sans-serif;
  --font-body:'Inter',sans-serif;
}
html,body{height:100%;font-family:var(--font-body);background:var(--beige-50);color:var(--brown-dark)}

/* ── LAYOUT ── */
.app{display:flex;height:100vh;overflow:hidden}

/* ── SIDEBAR ── */
.sidebar{
  width:260px;min-width:260px;
  background:var(--brown-dark);
  display:flex;flex-direction:column;
  border-right:1px solid rgba(255,255,255,0.06);
}
.sb-header{
  padding:16px 12px 12px;
  display:flex;align-items:center;justify-content:space-between;
  border-bottom:0.5px solid rgba(255,255,255,0.07);
}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none}
.logo-icon{
  width:34px;height:34px;border-radius:10px;
  background:var(--beige-100);
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;
}
.logo-icon span{
  font-family:var(--font-main);font-size:19px;font-weight:700;
  background:linear-gradient(135deg,var(--red),var(--green));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  line-height:1;
}
.logo-name{
  font-family:var(--font-main);font-size:15px;font-weight:600;
  color:var(--beige-100);letter-spacing:0.02em;
}
.logo-name em{color:var(--green);font-style:normal}
.icon-btn-sb{
  background:none;border:none;cursor:pointer;
  color:var(--brown-muted);padding:5px;border-radius:6px;
  display:flex;align-items:center;justify-content:center;
  transition:background .15s,color .15s;
}
.icon-btn-sb:hover{background:rgba(255,255,255,0.08);color:var(--beige-100)}

.new-chat-btn{
  margin:12px 10px 6px;
  padding:9px 14px;border-radius:9px;
  border:0.5px solid rgba(212,180,131,0.25);
  background:rgba(212,180,131,0.07);
  color:var(--beige-200);font-size:13px;
  font-family:var(--font-body);
  cursor:pointer;display:flex;align-items:center;gap:9px;
  transition:background .15s;
}
.new-chat-btn:hover{background:rgba(212,180,131,0.14);color:var(--beige-100)}

.section-label{
  padding:10px 14px 3px;
  font-size:10px;color:#7a5c3e;
  font-weight:600;letter-spacing:0.07em;text-transform:uppercase;
  font-family:var(--font-main);
}
.chat-list{display:flex;flex-direction:column;gap:1px;padding:0 8px}
.chat-item{
  padding:8px 10px;font-size:13px;color:var(--brown-muted);
  cursor:pointer;border-radius:7px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  transition:background .12s,color .12s;
  border-left:2px solid transparent;
}
.chat-item:hover{background:rgba(212,180,131,0.09);color:var(--beige-200)}
.chat-item.active{
  background:rgba(192,57,43,0.15);color:#f5a899;
  border-left:2px solid var(--red);
}

.sb-spacer{flex:1}
.sb-footer{
  padding:10px;
  border-top:0.5px solid rgba(255,255,255,0.07);
}
.user-row{
  display:flex;align-items:center;gap:10px;
  padding:8px 6px;border-radius:8px;cursor:pointer;
  transition:background .12s;
}
.user-row:hover{background:rgba(255,255,255,0.06)}
.avatar{
  width:32px;height:32px;border-radius:50%;flex-shrink:0;
  background:linear-gradient(135deg,var(--red),var(--green-dark));
  display:flex;align-items:center;justify-content:center;
  font-size:13px;font-weight:600;color:#fff;
  font-family:var(--font-main);
}
.user-info{flex:1;min-width:0}
.user-name{font-size:13px;color:var(--beige-200);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.user-plan{font-size:11px;color:#7a5c3e}

/* ── MAIN ── */
.main{flex:1;display:flex;flex-direction:column;background:var(--beige-50);min-width:0}

.topbar{
  padding:12px 20px;
  border-bottom:0.5px solid var(--beige-200);
  background:#fff;
  display:flex;align-items:center;justify-content:space-between;
  flex-shrink:0;
}
.model-pill{
  display:flex;align-items:center;gap:7px;
  padding:6px 14px;border-radius:20px;
  border:0.5px solid var(--beige-200);background:#fff;
  cursor:pointer;font-size:13px;font-weight:500;
  color:var(--brown-mid);font-family:var(--font-main);
  transition:background .15s;
}
.model-pill:hover{background:var(--beige-50)}
.dot-r{width:8px;height:8px;border-radius:50%;background:var(--red)}
.dot-g{width:8px;height:8px;border-radius:50%;background:var(--green)}
.topbar-actions{display:flex;gap:7px}
.icon-btn-top{
  width:34px;height:34px;border-radius:8px;
  border:0.5px solid var(--beige-200);background:#fff;
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  color:var(--brown-soft);transition:background .15s;
}
.icon-btn-top:hover{background:var(--beige-100)}

/* ── CHAT AREA ── */
.chat-area{
  flex:1;overflow-y:auto;
  padding:32px 24px;
  display:flex;flex-direction:column;gap:20px;
  scroll-behavior:smooth;
}
.chat-area::-webkit-scrollbar{width:5px}
.chat-area::-webkit-scrollbar-track{background:transparent}
.chat-area::-webkit-scrollbar-thumb{background:var(--beige-200);border-radius:3px}

/* Welcome */
.welcome{
  display:flex;flex-direction:column;align-items:center;
  justify-content:center;flex:1;gap:16px;padding:20px 0 30px;
}
.welcome-icon{
  width:60px;height:60px;border-radius:18px;
  background:var(--beige-100);border:1px solid var(--beige-200);
  display:flex;align-items:center;justify-content:center;
}
.welcome-icon span{
  font-family:var(--font-main);font-size:34px;font-weight:800;
  background:linear-gradient(135deg,var(--red),var(--green));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  line-height:1;
}
.welcome h1{
  font-family:var(--font-main);font-size:22px;font-weight:600;
  color:var(--brown-dark);text-align:center;
}
.welcome p{
  font-size:14px;color:var(--brown-soft);
  text-align:center;max-width:320px;line-height:1.65;
}
.chips{
  display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:4px;
}
.chip{
  padding:7px 15px;border-radius:20px;
  border:0.5px solid var(--beige-200);background:#fff;
  font-size:12px;color:var(--brown-mid);cursor:pointer;
  transition:border-color .15s,color .15s,background .15s;
  font-family:var(--font-body);
}
.chip:hover{border-color:var(--red);color:var(--red);background:#fff5f4}

/* Messages */
.msg{display:flex;gap:10px;align-items:flex-start}
.msg.user{flex-direction:row-reverse}
.msg-av{
  width:30px;height:30px;border-radius:50%;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  font-size:13px;font-weight:700;font-family:var(--font-main);
}
.msg.user .msg-av{
  background:linear-gradient(135deg,var(--red),#a93226);color:#fff;
}
.msg.ai .msg-av{
  background:var(--beige-100);border:0.5px solid var(--beige-200);
  color:var(--green-dark);
}
.msg-bubble{
  padding:12px 16px;border-radius:14px;
  font-size:14px;line-height:1.7;max-width:78%;
  white-space:pre-wrap;
}
.msg.user .msg-bubble{
  background:linear-gradient(135deg,var(--red),#a93226);
  color:#fff;border-bottom-right-radius:3px;
}
.msg.ai .msg-bubble{
  background:#fff;color:var(--brown-dark);
  border:0.5px solid var(--beige-200);
  border-bottom-left-radius:3px;
  box-shadow:0 1px 4px rgba(0,0,0,0.04);
}
.msg.ai .msg-bubble strong{color:var(--green-dark)}
.tag{
  display:inline-block;padding:2px 8px;border-radius:4px;font-size:12px;
  font-weight:600;background:#e8f8ef;color:var(--green-dark);
  margin:0 2px;font-family:var(--font-main);
}

/* ── COMPOSER ── */
.composer-wrap{
  padding:10px 20px 18px;background:var(--beige-50);flex-shrink:0;
}
.composer{
  border:1px solid var(--beige-200);border-radius:16px;
  background:#fff;padding:12px 14px;
  display:flex;flex-direction:column;gap:10px;
  box-shadow:0 2px 8px rgba(0,0,0,0.05);
  transition:border-color .2s,box-shadow .2s;
}
.composer:focus-within{
  border-color:var(--red);
  box-shadow:0 2px 8px rgba(192,57,43,0.12);
}
.composer-input{
  border:none;outline:none;background:none;
  font-size:14px;color:var(--brown-dark);
  resize:none;min-height:40px;max-height:140px;
  line-height:1.55;font-family:var(--font-body);width:100%;
}
.composer-input::placeholder{color:#b8a080}
.composer-footer{display:flex;align-items:center;justify-content:space-between}
.composer-tools{display:flex;gap:6px}
.tool-btn{
  padding:5px 12px;border-radius:8px;
  border:0.5px solid var(--beige-200);background:none;
  cursor:pointer;font-size:12px;color:var(--brown-soft);
  display:flex;align-items:center;gap:5px;
  font-family:var(--font-body);
  transition:background .12s,border-color .12s,color .12s;
}
.tool-btn:hover{
  background:var(--beige-50);color:var(--brown-mid);
  border-color:var(--beige-300);
}
.send-btn{
  width:36px;height:36px;border-radius:10px;
  background:var(--red);border:none;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:background .15s,transform .1s;
  flex-shrink:0;
}
.send-btn:hover{background:var(--red-dark)}
.send-btn:active{transform:scale(0.95)}
.send-btn svg{color:#fff}
.disclaimer{
  text-align:center;font-size:11px;color:#b8a080;
  padding:5px 0 0;line-height:1.5;
}

/* ── RESPONSIVE ── */
@media(max-width:640px){
  .sidebar{display:none}
  .chat-area{padding:20px 14px}
  .composer-wrap{padding:8px 12px 14px}
}
</style>
</head>
<body>
<div class="app">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sb-header">
      <a class="logo" href="#">
        <div class="logo-icon"><span>K</span></div>
        <span class="logo-name">kroby<em>.ia</em></span>
      </a>
      <button class="icon-btn-sb" title="Nuevo chat">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M12 5v14M5 12h14"/>
        </svg>
      </button>
    </div>

    <button class="new-chat-btn">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M12 5v14M5 12h14"/>
      </svg>
      Nuevo chat
    </button>

    <div class="sb-spacer"></div>

    <div class="sb-footer">
      <div class="user-row">
        <div class="avatar">R</div>
        <div class="user-info">
          <div class="user-name">ronilio</div>
          <div class="user-plan">Plan gratuito</div>
        </div>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7a5c3e" stroke-width="2">
          <circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>
        </svg>
      </div>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main">
    <div class="topbar">
      <div class="model-pill">
        <div class="dot-r"></div>
        <div class="dot-g"></div>
        Kroby IA · GRATUITO
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </div>
      <div class="topbar-actions">
        <button class="icon-btn-top" title="Compartir">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13"/>
          </svg>
        </button>
        <button class="icon-btn-top" title="Opciones">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="chat-area" id="chatArea">

      <!-- Welcome -->
      <div class="welcome" id="welcome">
        <div class="welcome-icon"><span>K</span></div>
        <h1>¿En qué te ayudo hoy?</h1>
        <p>Soy Kroby IA, tu asistente inteligente para negocios, creatividad y productividad.</p>
        <div class="chips">
          <div class="chip" onclick="sendChip(this)">✍️ Redactar contenido</div>
          <div class="chip" onclick="sendChip(this)">📊 Analizar datos</div>
          <div class="chip" onclick="sendChip(this)">💡 Ideas de negocio</div>
          <div class="chip" onclick="sendChip(this)">🌐 Traducir texto</div>
          <div class="chip" onclick="sendChip(this)">📧 Redactar email</div>
          <div class="chip" onclick="sendChip(this)">📅 Planificar tareas</div>
        </div>
      </div>

    </div>

    <!-- COMPOSER -->
    <div class="composer-wrap">
      <div class="composer">
        <textarea
          class="composer-input"
          id="composerInput"
          placeholder="Escribe tu pregunta a Kroby IA..."
          rows="1"
          onkeydown="handleKey(event)"
          oninput="autoResize(this)"
        ></textarea>
        <div class="composer-footer">
          <div class="composer-tools">
            <button class="tool-btn">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
              </svg>
              Adjuntar
            </button>
            <button class="tool-btn">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
              </svg>
              Buscar
            </button>
          </div>
          <button class="send-btn" id="sendBtn" onclick="sendMessage()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
      <p class="disclaimer">Kroby IA puede cometer errores. Verifica la información importante.</p>
    </div>
  </main>
</div>

<script>
const chatArea = document.getElementById('chatArea');
const input = document.getElementById('composerInput');
const welcome = document.getElementById('welcome');

const responses = [
  `El plan Chill (Café y caminata)\nEs la opción con menos presión. Solo es caminar y platicar. Respondele:\n\n¡Todo bien también! Oye, el clima está perfecto para caminar un rato. ¿Te late si vamos a dar una vuelta al parque el sábado y pasamos por un café?`,
  `¡Excelente pregunta! Para empezar suave (romper el hielo):\n\n• ¿Qué te gusta hacer cuando tienes tiempo libre?\n• ¿Eres más de planes tranquilos o de salir a lo loco?\n• ¿Qué tipo de música te gusta últimamente?\n• ¿Café o té?`,
  `Para que la conversación fluya dile:\n\n"¿Qué es algo que te apasiona tanto que podrías dar una charla de 20 minutos sin prepararte?"`,
  `Alcanzaste el límite diario de mensajes. Para continuar la conversación, adquiere la membresía Kroby asistente premium.`,
];

let msgCount = 0;

function autoResize(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 140) + 'px';
}

function handleKey(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
}

function sendChip(el) {
  input.value = el.textContent.replace(/^[^\w]+/, '').trim();
  sendMessage();
}

function sendMessage() {
  const text = input.value.trim();
  if (!text) return;

  if (welcome && welcome.parentNode) {
    welcome.remove();
  }

  addMessage(text, 'user');
  input.value = '';
  input.style.height = 'auto';

  setTimeout(() => {
    const r = responses[msgCount % responses.length];
    addMessage(r, 'ai');
    msgCount++;
  }, 900);
}

function addMessage(text, role) {
  const div = document.createElement('div');
  div.className = 'msg ' + role;

  const av = document.createElement('div');
  av.className = 'msg-av';
  av.textContent = role === 'user' ? 'R' : 'K';

  const bubble = document.createElement('div');
  bubble.className = 'msg-bubble';
  bubble.textContent = text; // white-space:pre-wrap en CSS renderiza los \n correctamente

  div.appendChild(av);
  div.appendChild(bubble);
  chatArea.appendChild(div);
  chatArea.scrollTop = chatArea.scrollHeight;
}

document.querySelectorAll('.chat-item').forEach(item => {
  item.addEventListener('click', function () {
    document.querySelectorAll('.chat-item').forEach(i => i.classList.remove('active'));
    this.classList.add('active');
  });
});
</script>
</body>
</html>
